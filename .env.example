# ============================================================
# Modèle de variables d'environnement pour docker-compose.
# Copier en `.env` et renseigner les vraies valeurs :
#   cp .env.example .env
# Le fichier `.env` réel est ignoré par git (secrets).
# ============================================================

# --- Base de données PostgreSQL ---
POSTGRES_DB=City
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_fort

# --- Email transactionnel (Resend) ---
# ⚠️ NE PAS committer de vraie clé. Régénérez celle qui était exposée.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- URL publique du frontend (liens dans les emails) ---
# Ex. https://smartcity.votre-domaine.mg  (ou http://IP_DU_VPS en attendant)
APP_FRONTEND_URL=http://localhost

# --- Géocodage Google (optionnel ; vide = OpenStreetMap) ---
GOOGLE_MAPS_API_KEY=
