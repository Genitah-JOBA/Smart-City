{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-backend",
            "type": "shell",
            "command": "cd backend; mvn spring-boot:run",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "start-frontend",
            "type": "shell",
            "command": "cd frontend; npm start",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "start-all",
            "dependsOn": ["start-backend", "start-frontend"],
            "parallel": true,
            "problemMatcher": []
        }
    ]
}